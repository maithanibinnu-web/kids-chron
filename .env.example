# ---------------------------------------------------------------
# KidsChron — environment variables
# Copy to .env.local and fill in what you have. Everything here is
# optional: with none of it set the site runs, and the interface
# tells visitors honestly what is not yet connected.
# ---------------------------------------------------------------

# --- Where form submissions go ---------------------------------
# Set EITHER a webhook (CRM, Zapier, Google Apps Script, your own
# endpoint) OR Resend email, or both. With neither, submissions are
# validated and logged on the server only, and the UI says so and
# points the visitor at the phone number instead.
KIDSCHRON_WEBHOOK_URL=
RESEND_API_KEY=
KIDSCHRON_NOTIFY_EMAIL=info@kidschron.com
KIDSCHRON_FROM_EMAIL="KidsChron <noreply@kidschron.com>"

# --- Payment gateway (optional) --------------------------------
# Leave blank to use the offline UPI / NEFT / IMPS route with manual
# verification against the bank record — how KidsChron takes payment
# today. Setting these switches the checkout to Razorpay.
# The webhook secret is required: /api/payments/webhook rejects any
# request it cannot verify by signature.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
